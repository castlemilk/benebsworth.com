#!/usr/bin/env bash
# Fast pre-commit gate (~15s): staged-file lint, typecheck, changed-prose lint.
# Logic lives in taskfiles/git.yml so it is documented and runnable by hand
# (`task git:pre-commit`).
#
# Bypass: SKIP_HOOKS=1 git commit ...   or   git commit --no-verify
set -euo pipefail

if [ "${SKIP_HOOKS:-}" = "1" ]; then
  echo "pre-commit: skipped (SKIP_HOOKS=1)"
  exit 0
fi

if ! command -v task >/dev/null 2>&1; then
  echo "pre-commit: 'task' not found — install it (brew install go-task) or commit with --no-verify" >&2
  exit 1
fi

exec task git:pre-commit
