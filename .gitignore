# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# nyc test coverage
.nyc_output

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Typescript v1 declaration files
typings/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# dotenv environment variables file
.env

# next.js
.next/
out/
next-env.d.ts
*.tsbuildinfo

# vercel
.vercel

# Mac files
.DS_Store

# Yarn
yarn-error.log
.pnp/
.pnp.js
# Yarn Integrity file
.yarn-integrity

# brainstorming visual companion
.superpowers/

# Playwright
test-results/
playwright-report/

# UI review artifacts
.playwright-mcp/
/*.png

# serena MCP workspace
.serena/

# LLM benchmark API response cache
.cache/

# old Gatsby site kept locally for reference (1.1GB)
legacy/
public/lab-data/

# Large raw model-generated HTML result variants (never commit — they execute in the browser)
lib/lab/llm-benchmark/results-*-html.json

# Stray artifacts a CLI model may drop in the repo root when its file-handoff
# resolves against the process cwd (opencode/agy write ./artifact.html there
# when the prompt's cwd resolution differs from the scratch dir; parallel
# sweeps use unique artifact-<model>-<task>-<n>.html names).
/artifact*.html

# Temporary working directories for scripts and manual review
tmp/

# Task runner fingerprint cache (Taskfile sources/generates checksums)
.task/

# graphify knowledge graph - commit the queryable graph, ignore regenerables
graphify-out/cache/
graphify-out/graph.html
graphify-out/.graphify_*
graphify-out/*/
!graphify-out/manifest.json
