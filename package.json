    "@usefluid/motion": "^0.1.2",
    "animejs": "^4.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-array": "^3.2.5",
    "d3-force": "^3.0.1",
    "d3-force-3d": "^3.0.6",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "exifr": "^7.1.3",
    "gray-matter": "^4.0.3",
    "katex": "^0.17.0",
    "lucide-react": "^1.17.0",
    "motion": "^14.14.0",
    "next": "^16.4.6",
    "next-mdx-remote": "^6.0.0",
    "ogl": "^1.0.11",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.3",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "roughjs": "4.6.6",
    "shadcn": "^4.8.3",
    "shiki": "^4.1.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.70.0",
    "@eslint/js": "^9.39.4",
    "@next/eslint-plugin-next": "^16.2.7",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/react": "^16.3.2",
    "@types/d3-array": "^3.2.2",
    "@types/d3-force": "^3.0.10",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.6.0",
    "jsdom": "^27.0.1",
    "pagefind": "^1.5.2",
    "postcss": "^8.5.15",
    "serve": "^14.2.6",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.0",
    "ts-proto": "^2.11.8",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.7",
    "wrangler": "^4.168.0"
  },
  "browserslist": [
    "defaults and fully supports es6-module-dynamic-import"
  ]
}
