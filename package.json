{
  "name": "benebsworth-com",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "_comment": "Task is the single source of truth for every core command — Taskfile.yml + taskfiles/*.yml carry each command's real inputs, outputs and gotchas. Run `task` to list them, `task <name> --summary` for the long-form docs. The scripts below are THIN ALIASES that delegate to Task, kept so npm muscle memory and IDE integrations keep working. Do not reimplement a pipeline here — edit the taskfile. Note there is deliberately no prebuild/postbuild pair any more: the pre/post phases are steps of `task build`, and duplicating them here would run them twice.",
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "build": "task build",
    "build:clean": "task build:clean",
    "md:siblings": "task build:gen:md",
    "lint": "task lint:eslint",
    "lint:prose": "task lint:prose",
    "lint:prose:changed": "task lint:prose:changed",
    "typecheck": "task lint:types",
    "test": "task test:unit",
    "test:watch": "task test:watch",
    "e2e": "task test:e2e",
    "verify": "task verify",
    "ci": "task ci",
    "proto:gen": "task build:gen:proto",
    "build:archive": "task build:archive",
    "deploy:next": "task deploy:staging",
    "deploy:prod": "task deploy:prod",
    "deploy:pages:next": "task deploy:staging",
    "deploy:pages:prod": "task deploy:prod",
    "deploy:aws:next": "task deploy:aws:staging",
    "deploy:aws:prod": "task deploy:aws:prod",
    "benchmark:run": "task bench:run"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.6",
    "@next/third-parties": "^16.2.9",
    "@tailwindcss/typography": "^0.5.19",
    "animejs": "^4.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exifr": "^7.1.3",
    "gray-matter": "^4.0.3",
    "katex": "^0.17.0",
    "lucide-react": "^1.17.0",
    "next": "^16.2.6",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^1.0.0-beta.0",
    "ogl": "^1.0.11",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.3",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shadcn": "^4.8.3",
    "shiki": "^4.1.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.70.0",
