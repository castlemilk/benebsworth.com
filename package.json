{
  "name": "benebsworth-com",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "study:engine": "node scripts/study-engine/index.mjs",
    "md:siblings": "node scripts/gen-md-siblings.mjs",
    "md:siblings:check": "node scripts/gen-md-siblings.mjs --check",
    "prebuild": "node scripts/prepare-grounded-artwork.mjs && node --import tsx scripts/prepare-grounded-discovery.mts && node scripts/gen-md-siblings.mjs && tsx scripts/gen-benchmark-outputs.mjs && node scripts/gen-harness-eval.mjs",
    "build": "next build",
    "postbuild": "node scripts/og-rewrite.mjs && node --import tsx scripts/build-search.mts && node --import tsx scripts/check-study-search.mts && node --import tsx scripts/check-grounded-output.mts",
    "start": "next start",
    "lint": "eslint .",
    "lint:prose": "node scripts/lint-prose.mjs",
    "lint:prose:json": "node scripts/lint-prose.mjs --format json",
    "lint:prose:changed": "node scripts/lint-prose.mjs --changed",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "proto:gen": "buf generate",
    "build:archive": "bash scripts/build-archive.sh",
    "deploy:next": "bash scripts/deploy-pages.sh staging",
    "deploy:prod": "bash scripts/deploy-pages.sh prod",
    "deploy:pages:next": "bash scripts/deploy-pages.sh staging",
    "deploy:pages:prod": "bash scripts/deploy-pages.sh prod",
    "deploy:aws:next": "bash scripts/deploy.sh staging",
    "deploy:aws:prod": "bash scripts/deploy.sh prod",
    "benchmark:run": "tsx scripts/run-benchmark.mjs",
    "predev": "node scripts/prepare-grounded-artwork.mjs && node --import tsx scripts/prepare-grounded-discovery.mts",
    "pretest": "node scripts/prepare-grounded-artwork.mjs && node --import tsx scripts/prepare-grounded-discovery.mts",
    "pretest:watch": "node scripts/prepare-grounded-artwork.mjs && node --import tsx scripts/prepare-grounded-discovery.mts",
    "artwork:prepare": "node scripts/prepare-grounded-artwork.mjs && node --import tsx scripts/prepare-grounded-discovery.mts",
    "artwork:check": "node scripts/prepare-grounded-artwork.mjs --check"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
