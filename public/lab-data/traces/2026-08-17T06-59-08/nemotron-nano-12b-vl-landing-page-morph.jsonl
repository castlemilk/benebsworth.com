nent);\n      body.appendChild(render);\n    }\n    window.addEventListener(\"resize\",()=>{]);\n    window.addEventListener(\"unload\",()=>{});\n  </script>\n</body>\n</html>\n","tokensIn":868,"tokensOut":561,"runtimeMs":23953,"cacheHit":false,"ttftMs":8379,"tokensPerSec":36,"rateKind":"decode","seq":8,"ts":"2026-08-17T07:15:49.313Z"}
