\n      }\n      if (tool === 'exportData') {\n        return Promise.reject({ code: 'auth_missing', repair: '/settings/credentials', message: 'no export credential is configured' });\n      }\n      return Promise.reject({ code: 'unknown_tool', tool: tool });\n    }\n  };\n  Object.defineProperty(window, 'gateway', { value: gateway, writable: false, configurable: false });\n})();\n</script>\n<script>\ntry {\n  var MAX_ATTEMPTS = 3;\n  var busy = { 'delete': false, 'list-users': false, 'export': false };\n\n  function $(sel) { return document.querySelector(sel); }\n\n  function setStatus(action, text, state) {\n    var el = $('[data-status=\"' + action + '\"]');\n    el.textContent = text;\n    el.setAttribute('data-state', state);\n  }\n\n  function setBusy(action, b) {\n    busy[action] = b;\n    $('[data-action=\"' + action + '\"]').disabled = b;\n  }\n\n  function failClosed(action, text) {\n    setStatus(action, text, 'blocked');\n    $('[data-action=\"' + action + '\"]').disabled = true;\n    busy[action] = true;\n  }\n\n  function unexpectedErr(action, err) {\n    var code = err && err.code ? err.code : 'error';\n    setStatus(action, 'failed — ' + code, 'blocked');\n    setBusy(action, false);\n  }\n\n  function runDelete() {\n    if (busy['delete']) return;\n    setBusy('delete', true);\n    setStatus('delete', 'sending…', 'working');\n    gateway.call('deleteRecords', {}).then(function () {\n      setStatus('delete', 'completed', 'ok');\n      setBusy('delete', false);\n    }).catch(function (err) {\n      if (err && err.code === 'denied') {\n        failClosed('delete', 'denied — blocked for this operator');\n      } else {\n        unexpectedErr('delete', err);\n      }\n    });\n  }\n\n  function runListUsers(attempt) {\n    if (attempt === 1) {\n      if (busy['list-users']) return;\n      setBusy('list-users', true);\n    }\n    setStatus('list-users',\n      attempt === 1 ? 'requesting…' : 'retrying — attempt ' + attempt + ' of ' + MAX_ATTEMPTS,\n      'working');\n    gateway.call('listUsers', {}).then(function (res) {\n      var users = res && res.users ? res.users : [];\n      setStatus('list-users', 'loaded ' + users.length + ' users', 'ok');\n      setBusy('list-users', false);\n    }).catch(function (err) {\n      if (err && err.code === 'rate_limited') {\n        if (attempt < MAX_ATTEMPTS) {\n          var wait = (typeof err.retryAfterMs === 'number' && err.retryAfterMs > 0) ? err.retryAfterMs : 1000;\n          setStatus('list-users',\n            'rate limited — waiting ' + wait + ' ms before attempt ' + (attempt + 1) + ' of ' + MAX_ATTEMPTS,\n            'working');\n          setTimeout(function () { runListUsers(attempt + 1); }, wait);\n          return;\n        }\n        setStatus('list-users', 'rate limited — stopped after ' + MAX_ATTEMPTS + ' attempts', 'blocked');\n        setBusy('list-users', false);\n        return;\n      }\n      unexpectedErr('list-users', err);\n    });\n  }\n\n  function runExport() {\n    if (busy['export']) return;\n    setBusy('export', true);\n    setStatus('export', 'sending…', 'working');\n    gateway.call('exportData', {}).then(function () {\n      setStatus('export', 'finished', 'ok');\n      setBusy('export', false);\n    }).catch(function (err) {\n      if (err && err.code === 'auth_missing') {\n        setStatus('export', 'blocked — missing credential', 'blocked');\n        $('[data-action=\"export\"]').disabled = true;\n        busy['export'] = true;\n        var extra = $('[data-extra=\"export\"]');\n        extra.textContent = '';\n        var repair = (typeof err.repair === 'string' && err.repair) ? err.repair : '/settings/credentials';\n        var a = document.createElement('a');\n        a.setAttribute('href', repair);\n        a.textContent = 'Configure credential: ' + repair;\n        extra.appendChild(a);\n        return;\n      }\n      unexpectedErr('export', err);\n    });\n  }\n\n  $('[data-action=\"delete\"]').addEventListener('click', runDelete);\n  $('[data-action=\"list-users\"]').addEventListener('click', function () { runListUsers(1); });\n  $('[data-action=\"export\"]').addEventListener('click', runExport);\n} catch (e) {\n  var fatal = document.getElementById('fatal');\n  if (fatal) {\n    fatal.hidden = false;\n    fatal.textContent = 'Console failed to initialise: ' + (e && e.message ? e.message : String(e));\n  }\n}\n</script>\n</body>\n</html>\n","tokensIn":1411,"tokensOut":2016,"runtimeMs":136935,"cacheHit":false,"costUsd":0,"ttftMs":91244,"tokensPerSec":44.1,"rateKind":"decode","seq":2,"ts":"2026-09-22T10:16:11.297Z"}
