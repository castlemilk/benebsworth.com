background:#3b1113;border:1px solid #e05656;border-radius:8px;color:#ffd7d7;font-size:12px;white-space:pre-wrap}\n@media (max-width:520px){#hud{max-width:200px;padding:10px 12px;font-size:11px}#hud h1{font-size:13px}}\n</style>\n</head>\n<body>\n<canvas id=\"c\"></canvas>\n<div id=\"hud\">\n  <h1>Pendulum Wave</h1>\n  <p class=\"cap\">Each pendulum completes one extra swing per 30&nbsp;s cycle than its longer neighbor.</p>\n  <div class=\"row\">\n    <label>Pendulums <span id=\"nVal\">24</span></label>\n    <input id=\"n\" type=\"range\" min=\"5\" max=\"60\" step=\"1\" value=\"24\">\n  </div>\n  <div class=\"row\">\n    <label>Gravity <span id=\"gVal\">9.81 m/s² · Earth</span></label>\n    <input id=\"g\" type=\"range\" min=\"1.6\" max=\"25\" step=\"0.01\" value=\"9.81\">\n  </div>\n  <div class=\"btns\">\n    <button id=\"pause\">Pause</button>\n    <button id=\"reset\">Reset</button>\n    <label class=\"chk\"><input id=\"trails\" type=\"checkbox\" checked> trails</label>\n  </div>\n  <div id=\"sync\"><div id=\"syncbar\"></div></div>\n  <div id=\"syncTxt\">resync in 30.0 s</div>\n</div>\n<div role=\"alert\" id=\"err\" hidden></div>\n<script>\ntry{\nconst TAU=Math.PI*2, G0=9.81, T=30, K=27, AMP=0.36;\nconst canvas=document.getElementById('c'), ctx=canvas.getContext('2d');\nconst $=id=>document.getElementById(id);\nlet W=0,H=0,dpr=1,pivotY=0,lenMax=0,mx=36;\nlet N=24,g=G0,tEff=0,paused=false,trails=true,rafId=0,last=-1;\nlet om=[],px=[],dl=[],hue=[],spacing=40;\n\nfunction build(){\n  om=[];hue=[];\n  for(let i=0;i<N;i++){\n    om.push(TAU*(K+i)/T);           // pendulum i does K+i swings per cycle T at 1 g\n    hue.push(190+150*(N>1?i/(N-1):0));\n  }\n  layout();\n}\nfunction layout(){\n  pivotY=Math.max(54,H*0.10);\n  lenMax=Math.max(80,H-pivotY-Math.max(30,H*0.08));\n  mx=Math.max(36,W*0.07);\n  spacing=N>1?(W-2*mx)/(N-1):W;\n  px=[];dl=[];\n  const L=om.map(w=>G0/(w*w));      // true length in metres: L = g/w^2\n  const lmin=Math.min.apply(null,L),lmax=Math.max.apply(null,L);\n  for(let i=0;i<N;i++){\n    px.push(N>1?mx+i*spacing:W/2);\n    const u=lmax>lmin?(L[i]-lmin)/(lmax-lmin):1;\n    dl.push(lenMax*(0.80+0.20*u));  // compressed length fan for display\n  }\n}\nfunction resize(){\n  dpr=Math.min(window.devicePixelRatio||1,2);\n  W=window.innerWidth;H=window.innerHeight;\n  canvas.width=Math.round(W*dpr);canvas.height=Math.round(H*dpr);\n  ctx.setTransform(dpr,0,0,dpr,0,0);\n  layout();\n  render();\n}\nfunction render(){\n  ctx.fillStyle=trails?'rgba(11,11,16,0.16)':'#0b0b10';\n  ctx.fillRect(0,0,W,H);\n  // support bar\n  ctx.strokeStyle='rgba(236,236,240,0.16)';ctx.lineWidth=2;\n  ctx.beginPath();ctx.moveTo(px[0]-22,pivotY);ctx.lineTo(px[N-1]+22,pivotY);ctx.stroke();\n  // bob positions\n  const pts=new Array(N);\n  for(let i=0;i<N;i++){\n    const th=AMP*Math.cos(om[i]*tEff);\n    pts[i]=[px[i]+dl[i]*Math.sin(th),pivotY+dl[i]*Math.cos(th)];\n  }\n  // strings\n  ctx.strokeStyle='rgba(236,236,240,0.18)';ctx.lineWidth=1;\n  ctx.beginPath();\n  for(let i=0;i<N;i++){ctx.moveTo(px[i],pivotY);ctx.lineTo(pts[i][0],pts[i][1]);}\n  ctx.stroke();\n  // emergent wave polyline through bob centres\n  ctx.strokeStyle='rgba(255,255,255,0.35)';ctx.lineWidth=1.4;\n  ctx.beginPath();\n  for(let i=0;i<N;i++){i?ctx.lineTo(pts[i][0],pts[i][1]):ctx.moveTo(pts[i][0],pts[i][1]);}\n  ctx.stroke();\n  // pivots\n  ctx.fillStyle='rgba(236,236,240,0.45)';\n  ctx.beginPath();\n  for(let i=0;i<N;i++){ctx.moveTo(px[i]+2,pivotY);ctx.arc(px[i],pivotY,2,0,TAU);}\n  ctx.fill();\n  // bobs (glow + core)\n  const r=Math.max(3,Math.min(11,spacing*0.34));\n  for(let i=0;i<N;i++){\n    const x=pts[i][0],y=pts[i][1],h=hue[i];\n    ctx.fillStyle='hsla('+h+',90%,65%,0.22)';\n    ctx.beginPath();ctx.arc(x,y,r*2.3,0,TAU);ctx.fill();\n    ctx.fillStyle='hsl('+h+',90%,68%)';\n    ctx.beginPath();ctx.arc(x,y,r,0,TAU);ctx.fill();\n  }\n}\nfunction frame(ts){\n  rafId=requestAnimationFrame(frame);\n  if(last<0)last=ts;\n  const dt=Math.min(0.05,(ts-last)/1000);last=ts;\n  const s=Math.sqrt(g/G0);          // w_i scales by sqrt(g): same rig, different planet\n  if(!paused)tEff+=s*dt;\n  render();\n  const p=(tEff%T)/T;\n  $('syncbar').style.width=(p*100).toFixed(1)+'%';\n  $('syncTxt').textContent='resync in '+(((1-p)*T)/s).toFixed(1)+' s';\n}\nfunction planet(v){\n  if(v<2)return'Moon';if(v<4.5)return'Mars';if(v<11)return'Earth';\n  if(v<17)return'Super-Earth';return'Jupiter';\n}\n$('n').addEventListener('input',e=>{N=+e.target.value;$('nVal').textContent=N;build();render();});\n$('g').addEventListener('input',e=>{g=+e.target.value;$('gVal').textContent=g.toFixed(2)+' m/s² · '+planet(g);});\n$('pause').addEventListener('click',e=>{paused=!paused;e.target.textContent=paused?'Resume':'Pause';});\n$('reset').addEventListener('click',()=>{tEff=0;});\n$('trails').addEventListener('change',e=>{trails=e.target.checked;});\nwindow.addEventListener('resize',resize);\nwindow.addEventListener('unload',()=>cancelAnimationFrame(rafId));\nbuild();\nresize();\nrafId=requestAnimationFrame(frame);\n}catch(e){\n  const d=document.getElementById('err');\n  d.hidden=false;\n  d.textContent='Error: '+(e&&e.message?e.message:e);\n}\n</script>\n</body>\n</html>\n","tokensIn":850,"tokensOut":1731,"runtimeMs":211571,"cacheHit":false,"costUsd":0,"ttftMs":154454,"tokensPerSec":30.3,"rateKind":"decode","seq":8,"ts":"2026-09-22T10:16:06.223Z"}
