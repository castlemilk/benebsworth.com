in(p) {\n    for (var k = 0; k < LINES.length; k++) {\n      var line = LINES[k];\n      if (state[line[0]] === p && state[line[1]] === p && state[line[2]] === p) {\n        return line;\n      }\n    }\n    return null;\n  }\n\n  function onMove(idx) {\n    if (over || state[idx]) return;\n    state[idx] = current;\n    var cell = cells[idx];\n    cell.textContent = current;\n    cell.classList.add(current === 'X' ? 'mark-x' : 'mark-o');\n    cell.disabled = true;\n\n    var winLine = findWin(current);\n    if (winLine) {\n      over = true;\n      for (var k = 0; k < winLine.length; k++) {\n        cells[winLine[k]].classList.add('win-line');\n      }\n      for (var j = 0; j < cells.length; j++) cells[j].disabled = true;\n      setStatus(markSpan(current) + ' <span class=\"win\">wins!</span>');\n      return;\n    }\n    if (state.every(function (s) { return s; })) {\n      over = true;\n      for (var j2 = 0; j2 < cells.length; j2++) cells[j2].disabled = true;\n      setStatus('It\\u2019s a draw!');\n      return;\n    }\n    current = current === 'X' ? 'O' : 'X';\n    setStatus(markSpan(current) + '\\u2019s turn');\n  }\n\n  function restart() {\n    state = [];\n    current = 'X';\n    over = false;\n    for (var j = 0; j < cells.length; j++) {\n      cells[j].textContent = '';\n      cells[j].disabled = false;\n      cells[j].classList.remove('mark-x', 'mark-o', 'win-line');\n    }\n    setStatus(markSpan('X') + '\\u2019s turn');\n  }\n\n  restartBtn.addEventListener('click', restart);\n  restart();\n} catch (err) {\n  var alert = document.createElement('div');\n  alert.setAttribute('role', 'alert');\n  alert.textContent = 'Failed to start the game: ' + (err && err.message ? err.message : String(err));\n  document.body.appendChild(alert);\n}\n</script>\n</body>\n</html>\n","tokensIn":783,"tokensOut":1379,"runtimeMs":37853,"cacheHit":false,"costUsd":0,"ttftMs":7170,"tokensPerSec":44.9,"rateKind":"decode","seq":5,"ts":"2026-09-22T10:13:13.908Z"}
